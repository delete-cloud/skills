{
  "$schema": "https://raw.githubusercontent.com/lathe-cli/kitup/main/spec/hosts.schema.json",
  "schemaVersion": 1,
  "hosts": [
    {
      "id": "kimi-cli",
      "displayName": "Kimi Code CLI",
      "projectSkillsDirs": [".kimi-code/skills", ".agents/skills"],
      "userSkillsDirs": ["~/.kimi-code/skills", "~/.agents/skills"],
      "detect": ["~/.kimi-code"],
      "status": "community",
      "notes": [
        "Local override 2026-09-08: kitup upstream table predates the official",
        "Kimi Code user skills dir ~/.kimi-code/skills; see",
        "https://www.kimi.com/code/docs/en/kimi-code-cli/customization/skills.html"
      ],
      "aliases": ["kimi-code-cli"]
    },
    {
      "id": "codex",
      "displayName": "Codex",
      "projectSkillsDirs": [".agents/skills"],
      "userSkillsDirs": ["~/.codex/skills", "~/.agents/skills"],
      "detect": ["~/.codex"],
      "status": "verified",
      "notes": ["Native dir first; ~/.agents/skills kept as compatibility root."]
    },
    {
      "id": "devin",
      "displayName": "Devin",
      "projectSkillsDirs": [".devin/skills", ".agents/skills"],
      "userSkillsDirs": ["~/.config/devin/skills", "~/.agents/skills"],
      "detect": ["~/.config/devin"],
      "status": "verified",
      "notes": [
        "Mirrors kitup built-in devin host (~/.config/devin/skills), plus",
        "~/.agents/skills as fallback; needed here because hosts_file replaces",
        "the built-in table. Devin reads both dirs (docs.extensibility/skills).",
        "Covers Devin sessions launched via lody."
      ]
    }
  ]
}
